# Copy to .env and fill in. Never commit .env.

# PayPal sandbox REST app (Developer Dashboard → Apps & Credentials → Sandbox).
# The app's business account must be in a Payouts-sending country (e.g. US).
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after the webhook is registered (mandatectl webhooks ensure); used to verify signatures.
PAYPAL_WEBHOOK_ID=

# Channel3 product catalog (https://trychannel3.com/developers).
CHANNEL3_API_KEY=

# Groq LLM inference (https://console.groq.com/keys).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_ORCHESTRATOR=openai/gpt-oss-120b
GROQ_MODEL_SUPPLIER=openai/gpt-oss-20b
# Studio AI panel chain: Claude (native Messages API), Gemini, NVIDIA, Groq.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
STUDIO_AI_NVIDIA_MODELS=stepfun-ai/step-5-preview,nvidia/nemotron-3-super-120b-a12b,z-ai/glm-5.3-flash

# Sandbox account roles (emails only)
SANDBOX_MERCHANT_EMAIL=
SANDBOX_SUPPLIER_A_EMAIL=
SANDBOX_SUPPLIER_B_EMAIL=
SANDBOX_BUYER_EMAIL=

# Postgres
DATABASE_URL=
TEST_DATABASE_URL=

# Kernel + suppliers (generate with: go run ./cmd/mandatectl keygen)
MANDATE_SIGNING_SEED=
MANDATE_KEY_ID=mandate-k1
SUPPLIER_A_SEED=
SUPPLIER_A_PUBLIC_KEY=
SUPPLIER_B_SEED=
SUPPLIER_B_PUBLIC_KEY=
# Public URLs
PUBLIC_BASE_URL=http://localhost:8080
CONSOLE_URL=http://localhost:3000
CLIENT_TOKEN_DOMAIN=
ALLOWED_ORIGINS=
# Step-up push (optional): long random topic
NTFY_TOPIC=
